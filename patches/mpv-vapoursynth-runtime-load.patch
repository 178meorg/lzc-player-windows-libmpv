@@ -804,9 +811,32 @@
 
 static int drv_vss_init(struct priv *p)
 {
+#ifdef _WIN32
+    // VSScript embeds Python; load it only when a VapourSynth filter is used.
+    const char *path = getenv("VSSCRIPT_PATH");
+    p->vsscript_lib = LoadLibraryA(path ? path : "VSScript.dll");
+    if (!p->vsscript_lib) {
+        MP_FATAL(p, "Could not load VapourSynth scripting DLL.\n");
+        return -1;
+    }
+    VS_CC const VSSCRIPTAPI *(*get_vsscript_api)(int) =
+        (void *)GetProcAddress(p->vsscript_lib, "getVSScriptAPI");
+    if (!get_vsscript_api) {
+        MP_FATAL(p, "Could not find getVSScriptAPI in VapourSynth scripting DLL.\n");
+        FreeLibrary(p->vsscript_lib);
+        p->vsscript_lib = NULL;
+        return -1;
+    }
+    p->vs_script_api = get_vsscript_api(VSSCRIPT_API_VERSION);
+#else
     p->vs_script_api = getVSScriptAPI(VSSCRIPT_API_VERSION);
+#endif
     if (!p->vs_script_api) {
         MP_FATAL(p, "Could not initialize VapourSynth scripting.\n");
+#ifdef _WIN32
+        FreeLibrary(p->vsscript_lib);
+        p->vsscript_lib = NULL;
+#endif
         return -1;
     }
     return 0;
@@ -815,6 +845,11 @@
 static void drv_vss_uninit(struct priv *p)
 {
     p->vs_script_api = NULL;
+#ifdef _WIN32
+    if (p->vsscript_lib)
+        FreeLibrary(p->vsscript_lib);
+    p->vsscript_lib = NULL;
+#endif
 }
 
